<?xml version="1.0" encoding="utf-8"?>
<robot name="taccap_left_gripper">
  <material name="shell">
    <color rgba="0.58 0.64 0.72 1" />
  </material>
  <!-- Both fingers carry the side colour (cyan left / pink right),
       matching TACCAP_TRAIL_COLOR so a gripper reads as the same
       object as its trajectory trail. -->
  <material name="finger">
    <color rgba="0.20 0.83 0.94 1" />
  </material>

  <link name="base_link">
    <visual>
      <geometry><mesh filename="meshes/base_link.STL" /></geometry>
      <material name="shell" />
    </visual>
  </link>

  <link name="link1">
    <visual>
      <geometry><mesh filename="meshes/link1.STL" /></geometry>
      <material name="finger" />
    </visual>
  </link>
  <joint name="joint1" type="revolute">
    <origin xyz="0.0122149972236626 -0.0199448287448794 0.00600002844806007" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="link1" />
    <axis xyz="0 0 -1" />
    <limit lower="0" upper="0.5047492196767601" effort="1" velocity="1" />
  </joint>

  <link name="link2">
    <visual>
      <geometry><mesh filename="meshes/link2.STL" /></geometry>
      <material name="finger" />
    </visual>
  </link>
  <joint name="joint2" type="revolute">
    <origin xyz="0.012215 0.019955 0.006" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="link2" />
    <axis xyz="0 0 -1" />
    <limit lower="-0.5047492196767601" upper="0" effort="1" velocity="1" />
    <mimic joint="joint1" multiplier="-1" offset="0" />
  </joint>

  <link name="link3">
    <visual>
      <geometry><mesh filename="meshes/link3.STL" /></geometry>
      <material name="shell" />
    </visual>
  </link>
  <joint name="joint3" type="fixed">
    <origin xyz="-0.010732 -0.023651 0.052704" rpy="1.6139 -0.25663 -2.471" />
    <parent link="base_link" />
    <child link="link3" />
  </joint>

  <link name="link4">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 -1.5707963267949" />
      <geometry><mesh filename="meshes/link4.STL" /></geometry>
      <material name="shell" />
    </visual>
  </link>
  <joint name="joint4" type="fixed">
    <origin xyz="0.164636788170065 0 -0.0158499715519367" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="link4" />
  </joint>
</robot>
