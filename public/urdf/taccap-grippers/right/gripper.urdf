<?xml version="1.0" encoding="utf-8"?>
<robot name="taccap_right_gripper">
  <material name="shell">
    <color rgba="0.58 0.64 0.72 1" />
  </material>
  <material name="finger_primary">
    <color rgba="0.96 0.45 0.71 1" />
  </material>
  <material name="finger_secondary">
    <color rgba="0.82 0.88 0.94 1" />
  </material>

  <link name="base_link">
    <visual>
      <geometry><mesh filename="meshes/base_link.STL" /></geometry>
      <material name="shell" />
    </visual>
  </link>

  <link name="link1">
    <visual>
      <geometry><mesh filename="meshes/link1.STL" /></geometry>
      <material name="finger_primary" />
    </visual>
  </link>
  <joint name="joint1" type="revolute">
    <origin xyz="0.012221 -0.019955 0.006" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="link1" />
    <axis xyz="0 0 -1" />
    <limit lower="0" upper="0.5047492196767601" effort="1" velocity="1" />
  </joint>

  <link name="link2">
    <visual>
      <geometry><mesh filename="meshes/link2.STL" /></geometry>
      <material name="finger_secondary" />
    </visual>
  </link>
  <joint name="joint2" type="revolute">
    <origin xyz="0.012221 0.019945 0.006" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="link2" />
    <axis xyz="0 0 -1" />
    <limit lower="-0.5047492196767601" upper="0" effort="1" velocity="1" />
    <mimic joint="joint1" multiplier="-1" offset="0" />
  </joint>

  <link name="link3">
    <visual>
      <geometry><mesh filename="meshes/link3.STL" /></geometry>
      <material name="shell" />
    </visual>
  </link>
  <joint name="joint3" type="fixed">
    <origin xyz="-0.011624 0.024077 0.053432" rpy="1.8957 0.012858 0.71928" />
    <parent link="base_link" />
    <child link="link3" />
  </joint>

  <link name="link4">
    <visual>
      <geometry><mesh filename="meshes/link4.STL" /></geometry>
      <material name="shell" />
    </visual>
  </link>
  <joint name="joint4" type="fixed">
    <origin xyz="0.164643038155223 0 -0.01599997155194" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="link4" />
  </joint>
</robot>

