# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
package-lock.json
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
/public/*
!/public/urdf/
!/public/media/
/public/media/*
!/public/media/xense-taccap.mp4

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code local settings
.claude/

# python bytecode from scripts/
__pycache__/
*.pyc

# Corpus history written by the homepage dashboard (lives under
# LOCAL_DATASET_ROOT, which is normally outside the repo).
.xense-viewer/

# Local Python env for scripts/ (see scripts/requirements.txt)
.venv/
